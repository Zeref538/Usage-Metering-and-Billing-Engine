# Copy to .env:  cp .env.example .env     (.env is git-ignored and docker-ignored)

# Database. compose.yaml builds DATABASE_URL from this password for the containers.
POSTGRES_PASSWORD=change-me-local-only
# For running the app or tests on your own machine against the compose database:
DATABASE_URL=postgresql://postgres:change-me-local-only@localhost:5433/billing

# Demo tenants created by `python -m app.seed`. Local demo keys; only their sha256 is stored.
DEMO_KEY_ACME=demo_acme_local_key
DEMO_KEY_GLOBEX=demo_globex_local_key

# Stripe, TEST MODE ONLY. The app refuses to start with a live key.
# Dashboard (test mode) > Developers > API keys > Secret key
STRIPE_SECRET_KEY=sk_test_replace_me
# Printed by:  stripe listen --forward-to localhost:8000/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Where Stripe Checkout sends the browser back to.
PUBLIC_BASE_URL=http://localhost:8000
